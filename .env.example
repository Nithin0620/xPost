# xPost secrets template. Copy to `.env` and fill in.
# .env is gitignored — never commit real keys.

# =============================================================================
# 1. LLM — the agent's brain (Gemini, free tier)
#    From: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. Telegram — agent sends you drafts/review here
#    From: Telegram @BotFather → /newbot → bot token
TELEGRAM_BOT_TOKEN=123456789:AA...
# Only this user ID may use the bot (get yours from @userinfobot)
TELEGRAM_ALLOWED_USERS=

# 3. X posting (official API). From developer.x.com → app → Keys and tokens.
#    xurl uses OAuth 2.0 (Client ID/Secret). Api Key/Secret + tokens are the
#    legacy OAuth 1.0a path (optional / used by agent.py fallback).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# OAuth 2.0 (required for xurl): Client ID / Client Secret
X_CLIENT_ID=
X_CLIENT_SECRET=

# Account handle used by the own-profile engagement scraper
X_HANDLE=your_x_handle
X_LOGIN_USERNAME=
X_LOGIN_PASSWORD=

# Legacy agent.py content mode (optional)
GITHUB_USERNAME=

# Telegram bot home channel (chat_id where the bot delivers drafts/approvals)
TELEGRAM_HOME_CHANNEL=
TELEGRAM_HOME_CHANNEL_THREAD_ID=