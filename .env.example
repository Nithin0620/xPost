# xPost secrets template. Copy to `.env` and fill in.
# .env is gitignored — never commit real keys.

# =============================================================================
# 1. LLM — the agent's brain
#    From: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# 2. Telegram — agent sends you drafts/review here
#    From: Telegram @BotFather → /newbot → bot token
TELEGRAM_BOT_TOKEN=123456789:AA...

# 3. X posting (official API). From developer.x.com → app → Keys and tokens.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Account handle used by the own-profile engagement scraper
X_HANDLE=your_x_handle
X_LOGIN_USERNAME=
X_LOGIN_PASSWORD=

# Legacy agent.py content mode (optional)
GITHUB_USERNAME=