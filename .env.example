# xPost secrets template. Copy to `.env` and fill in.
# .env is gitignored — never commit real keys.

# =============================================================================
# 1. LLM — the agent's brain (Gemini, free tier)
#    From: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional model override (default: gemini-3.1-flash-lite)
GEMINI_MODEL=

# 2. Telegram — agent sends you drafts/review here
#    From: Telegram @BotFather → /newbot → bot token
TELEGRAM_BOT_TOKEN=123456789:AA...
# Only this user ID may use the bot (get yours from @userinfobot)
TELEGRAM_ALLOWED_USERS=

# 3. X posting (official API via xurl — the only posting path).
#    From developer.x.com → app → Keys and tokens. Then run `xurl auth oauth2`.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Account handle used by the own-profile engagement scraper
X_HANDLE=your_x_handle

# agent.py "github" content mode (optional)
GITHUB_USERNAME=

# Telegram bot home channel (chat_id where the bot delivers drafts/approvals)
TELEGRAM_HOME_CHANNEL=
TELEGRAM_HOME_CHANNEL_THREAD_ID=
# MongoDB Atlas (durable store for drafts, posts, engagement snapshots)
MONGODB_URI=
